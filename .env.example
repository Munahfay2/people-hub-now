# ─── Supabase (required for CMS) ─────────────────────────────────────────────
# Create a project at https://supabase.com → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ─── Sanity CMS (optional fallback for public content) ─────────────────────────
VITE_SANITY_PROJECT_ID=your_project_id_here
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01

# ─── Web3Forms (email notifications for Speak Up & Book Meeting) ───────────────
VITE_WEB3FORMS_ACCESS_KEY=your_access_key_here

# ─── Formspree (optional — contact / join team forms) ────────────────────────
VITE_FORMSPREE_JOIN_TEAM=xxxxxxxx
VITE_FORMSPREE_CONTACT=xxxxxxxx

# ─── Sanity Studio (only needed in the /sanity folder) ───────────────────────
SANITY_STUDIO_PROJECT_ID=your_project_id_here
